{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Panel P0",
  "version": "0.0.0",
  "identifier": "dev.cursor-panel.p0",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "Cursor Panel · P0", "width": 960, "height": 700, "minWidth": 580, "minHeight": 580}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "externalBin": ["binaries/p0-backend"] }
}
