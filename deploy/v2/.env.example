CURSOR_PANEL_DOMAIN=panel.example.com
# Both the application and maintenance service use this exact image.
CURSOR_PANEL_IMAGE=cursor-panel-v2:local
CURSOR_PANEL_VERSION=0.0.2
CURSOR_PANEL_REVISION=unrecorded
# The update service switches to a new data volume after a successful migration.
CURSOR_PANEL_DATA_VOLUME=cursor-panel-v2_data
