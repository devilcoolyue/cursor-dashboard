[Unit]
Description=Cursor quota dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cursorpanel
Group=cursorpanel
WorkingDirectory=/data/app/cursor-dashboard
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE_PATH=/data/app/cursor-dashboard/data/accounts.db
Environment=ACCOUNTS_PATH=/data/app/cursor-dashboard/data/accounts.json
# 部署样例：先按 docs/operations.md 调整用户、路径和监听地址。
# 对外监听务必设置共享口令；普通面板用户可修改账号，管理员仍使用独立登录。
#Environment=PANEL_TOKEN=<随机串>
# 后台目标周期默认 900 秒；常规每账号 6 个桌面接口，不含续期与重试。
# 实际周期还包括取数耗时、空闲和退避；缩短周期会增加长期出站量。
#Environment=REFRESH_INTERVAL=900
ExecStart=/data/app/cursor-dashboard/.venv/bin/cursor-panel --host 192.168.3.166 --port 8787 --no-open
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/data/app/cursor-dashboard/data

[Install]
WantedBy=multi-user.target
